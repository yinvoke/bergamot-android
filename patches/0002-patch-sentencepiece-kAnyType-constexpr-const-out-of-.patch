From f86c7d2c47c73e94e91a406ef5b6ec5683caf941 Mon Sep 17 00:00:00 2001
From: yinvoker <yinvoker@outlook.com>
Date: Mon, 31 Aug 2026 20:19:56 +0800
Subject: [PATCH] patch: sentencepiece kAnyType constexpr->const (out-of-range
 enum cast rejected by clang 17+)

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 .../src/3rd_party/sentencepiece/src/trainer_interface.cc        | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/engine/marian-fork/src/3rd_party/sentencepiece/src/trainer_interface.cc b/engine/marian-fork/src/3rd_party/sentencepiece/src/trainer_interface.cc
index 31659cb..6400c1c 100644
--- a/engine/marian-fork/src/3rd_party/sentencepiece/src/trainer_interface.cc
+++ b/engine/marian-fork/src/3rd_party/sentencepiece/src/trainer_interface.cc
@@ -208,7 +208,7 @@ bool TrainerInterface::IsValidSentencePiece(
     return false;
   }
 
-  constexpr unicode_script::ScriptType kAnyType =
+  const unicode_script::ScriptType kAnyType =
       static_cast<unicode_script::ScriptType>(-1);
 
   auto is_number = [](char32 c) { return (c >= 0x30 && c <= 0x39); };
-- 
